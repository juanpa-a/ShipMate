---
const { token } = Astro.locals;
---

<nav-bar class="fixed w-screen bg-zinc-950 p-4 border-b border-zinc-700">
    <div class="container mx-auto flex justify-between items-center">
        <div
            class="text-white text-lg py-1 px-2 rounded-md font-bold hover:bg-zinc-600"
        >
            ShipMate 🧉
        </div>

        <div>
            <button
                id={token ? "logout" : "login"}
                class="bg-zinc-950 hover:bg-slate-800 border border-zinc-700 text-zinc-400 transition-colors duration-200 ease-in-out hover:text-zinc-300 px-4 py-1 rounded"
            >
                {token ? "Log Out" : "Log In"}
            </button>
        </div>
    </div>
</nav-bar>

<script>
    import { api } from "~/services/api";

    class Navbar extends HTMLElement {
        constructor() {
            super();

            const login = this.querySelector<HTMLElement>("#login");
            const logout = this.querySelector<HTMLElement>("#logout");

            if (login) {
                login.onclick = async () => {
                    try {
                        const response = await api
                            .collection("users")
                            .authWithOAuth2({ provider: "google" });

                        if (response && response.token && response.record) {
                            // Update the client-side auth store immediately
                            api.authStore.save(response.token, response.record);

                            // Set the cookie for server-side and subsequent visits
                            // The middleware will handle setting pb_auth from this token cookie if needed,
                            // or we can directly set pb_auth cookie here too.
                            // For simplicity, we'll stick to the "token" cookie.
                            const cookieOptions = "path=/; SameSite=Lax; Max-Age=604800;"; // Max-Age=7 days
                            document.cookie = `token=${response.token}; ${cookieOptions}`;

                            location.reload(); // Reload to reflect server-side changes and ensure consistency
                        } else {
                            console.error("OAuth login failed or response was incomplete:", response);
                            // Potentially clear auth store if response is malformed but indicates failure
                            api.authStore.clear();
                        }
                    } catch (error) {
                        console.error("Error during OAuth login:", error);
                        api.authStore.clear(); // Clear auth on error
                    }
                };
            }

            if (logout) {
                logout.onclick = () => {
                    // Clear the client-side auth store immediately
                    api.authStore.clear();

                    // Clear the token cookie
                    const pastDate = new Date(0).toUTCString();
                    document.cookie = `token=; path=/; Expires=${pastDate}; SameSite=Lax;`;
                    // Also attempt to clear PocketBase's own cookie if it was set client-side, though middleware should handle server-set ones.
                    document.cookie = `pb_auth=; path=/; Expires=${pastDate}; SameSite=Lax;`;

                    location.reload(); // Reload to reflect logged-out state
                };
            }
        }
    }

    customElements.define("nav-bar", Navbar);
</script>
